# Discord Bot Token (required)
DISCORD_TOKEN=your_discord_bot_token_here

# OpenAI API Key (optional — only needed if using LLM mode instead of Markov)
OPENAI_API_KEY=your_openai_api_key_here

# Bot personality name
BOT_NAME=Retep

# Number of random messages per day
MESSAGES_PER_DAY=3

# Active hours window (24h format) — fallback if not enough data to auto-detect
ACTIVE_HOURS_START=10
ACTIVE_HOURS_END=23

# History depth — max messages to fetch per channel during /sync
HISTORY_DEPTH=10000

# OpenAI model to use (only relevant for LLM mode)
OPENAI_MODEL=gpt-4o-mini

# Database path
DB_PATH=retep.db
